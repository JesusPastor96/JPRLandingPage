---
const experience = [
  {
    role: "Desarrollador Web Freelance Full-Stack",
    company: "Bubblerally Tennis Platform",
    period: "Agosto 2026",
    description: 'Diseño, desarrollo y puesta en <strong>producción</strong> de una <strong>plataforma SaaS integral</strong> de reservas de pistas de tenis y gestión de academias. Backend construido con <strong>Spring Boot 3</strong> y <strong>Java 21</strong> bajo <strong>arquitectura limpia (SOLID)</strong>, con integración de <strong>Stripe</strong> (Apple Pay, Google Pay). Frontend en <strong>Angular 18 Standalone</strong>, desplegado en <strong>VPS IONOS</strong> mediante <strong>Docker</strong> y pipelines <strong>CI/CD</strong> automatizados.'
  },
  {
    role: "Desarrollador web en prácticas",
    company: "Biodatup, Pamplona",
    period: "Enero 2026 - Abril 2026",
    description: 'Participación activa en la construcción de una <strong>plataforma de ensayos clínicos</strong>, desarrollando servicios backend con <strong>Django</strong> e interfaces frontend modernas en <strong>React</strong>. Diseño de <strong>modelos de datos relacionales</strong> y consultas SQL orientadas a ofrecer información fiable para los equipos clínicos y de producto.'
  },
  {
    role: "Responsable de almacén y distribución",
    company: "Headlane Ltd., Londres",
    period: "2020 – 2025",
    description: 'Gestión integral de la <strong>recepción y clasificación de mercancía</strong> de tecnología móvil. Implementación de procesos de <strong>control de inventario</strong> y coordinación de la <strong>distribución</strong> eficiente de piezas, asegurando trazabilidad y cumplimiento de plazos de entrega.'
  },
  {
    role: "Team Leader",
    company: "Vital Ingredient, Londres",
    period: "2018 – 2020",
    description: 'Liderazgo de un equipo operativo con foco en <strong>atención al cliente</strong>, <strong>organización de tareas</strong> y <strong>contacto con proveedores</strong>. Supervisión del <strong>control de stock</strong> y la producción diaria bajo procesos estandarizados, garantizando eficiencia y calidad en el servicio.'
  },
  {
    role: "Asistente de Gerente",
    company: "Infopapel, Cádiz",
    period: "2015 – 2018",
    description: 'Responsable del <strong>control de stock</strong>, gestión de <strong>pedidos</strong>, atención directa a clientes y <strong>facturación</strong>. Asesoramiento en la <strong>toma de decisiones</strong> sobre productos informáticos y de oficina, contribuyendo al crecimiento comercial del negocio.'
  }
];

const education = [
  {
    title: "G.S. Desarrollo de Aplicaciones Web (DAW)",
    institution: "UNIR - Universidad Internacional de La Rioja",
    period: "2024 - 2026 (Graduado)",
    description: "Estudio de diseño y desarrollo de páginas web, configuración de bases de datos, frameworks de frontend, frameworks de backend y desarrollo de aplicaciones."
  },
  {
    title: "G.S. Administración y Finanzas",
    institution: "IES Los Viveros",
    period: "En curso (Pendiente Prácticas)",
    description: "Gestión contable, fiscalidad, tesorería, documentación financiera y recursos humanos."
  }
];
---

<section class="py-8 md:py-9 border-b border-border/40">
  <div class="mb-6 reveal">
    <h3 class="text-2xl font-display font-bold text-foreground" data-i18n="experience.title">
      Experiencia Profesional
    </h3>
  </div>

  <div class="divide-y divide-border/30">
    {experience.map((exp, index) => (
      <article class="py-6 first:pt-0 last:pb-0 reveal" style={`transition-delay: ${index * 80 + 60}ms;`}>
        <div class="flex flex-col md:flex-row md:gap-8 items-start">
          <div class="w-full md:w-1/4 shrink-0 mb-2 md:mb-0">
            <span class="font-mono text-xs sm:text-sm text-muted-foreground/80 uppercase tracking-wider block pt-1" data-i18n={`experience.items.${index}.period`}>
              {exp.period}
            </span>
          </div>
          <div class="w-full md:w-3/4 flex flex-col">
            <h4 class="text-lg sm:text-xl font-semibold text-foreground mb-1 tracking-tight" data-i18n={`experience.items.${index}.role`}>
              {exp.role}
            </h4>
            <span class="text-xs sm:text-sm font-mono text-primary font-medium mb-2.5" data-i18n={`experience.items.${index}.company`}>
              {exp.company}
            </span>
            <p class="text-base leading-relaxed text-muted-foreground [&>strong]:font-normal [&>strong]:text-inherit" data-i18n={`experience.items.${index}.description`} set:html={exp.description}>
            </p>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>

<section class="py-8 md:py-9 border-b border-border/40">
  <div class="mb-6 reveal">
    <h3 class="text-2xl font-display font-bold text-foreground" data-i18n="experience.eduTitle">
      Educación
    </h3>
  </div>

  <div class="divide-y divide-border/30">
    {education.map((edu, index) => (
      <article class="py-6 first:pt-0 last:pb-0 reveal" style={`transition-delay: ${index * 80 + 60}ms;`}>
        <div class="flex flex-col md:flex-row md:gap-8 items-start">
          <div class="w-full md:w-1/4 shrink-0 mb-2 md:mb-0">
            <span class="font-mono text-xs sm:text-sm text-muted-foreground/80 uppercase tracking-wider block pt-1" data-i18n={`experience.eduItems.${index}.period`}>
              {edu.period}
            </span>
          </div>
          <div class="w-full md:w-3/4 flex flex-col">
            <h4 class="text-lg sm:text-xl font-semibold text-foreground mb-1 tracking-tight" data-i18n={`experience.eduItems.${index}.title`}>
              {edu.title}
            </h4>
            <span class="text-xs sm:text-sm font-mono text-primary font-medium mb-2.5" data-i18n={`experience.eduItems.${index}.institution`}>
              {edu.institution}
            </span>
            <p class="text-base leading-relaxed text-muted-foreground [&>strong]:font-normal [&>strong]:text-inherit" data-i18n={`experience.eduItems.${index}.description`}>
              {edu.description}
            </p>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>
