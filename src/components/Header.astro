---
import { Mail, Github, Linkedin } from 'lucide-react';
---

<header class="py-10 sm:py-12 md:py-14 border-b border-border/40">
  <div class="flex flex-row justify-between items-center gap-4 sm:gap-6 md:gap-8">
    <div class="flex-1 min-w-0 text-left reveal delay-100">
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-display font-extrabold text-foreground tracking-tight leading-tight mb-2">
        <span class="header-name-1">Jesús</span> <span class="header-name-2">Pastor</span> <span class="header-name-3 text-primary">Ricoy</span>
      </h1>
      <h2 class="text-sm sm:text-base md:text-xl text-muted-foreground font-medium mb-3 sm:mb-4 header-anim-role" data-i18n="header.role">
        Desarrollador Web Full-Stack
      </h2>
      <p class="text-sm sm:text-base text-muted-foreground/90 max-w-lg mb-5 sm:mb-6 leading-relaxed header-anim-desc" data-i18n="header.description">
        Desarrollador Full Stack en Pamplona, España 🇪🇸. Apasionado por la tecnología, el diseño y la innovación continua. Comprometido con la creación de experiencias web excepcionales y soluciones eficientes.
      </p>
      <div class="flex flex-wrap gap-x-4 gap-y-2 sm:gap-5 text-xs font-mono text-muted-foreground justify-start">
        <a href="mailto:jesus.pastor.ricoy@gmail.com" class="inline-flex items-center gap-1.5 hover:text-foreground transition-colors group/link header-anim-link-1">
          <Mail class="w-3.5 h-3.5 text-primary shrink-0" />
          <span class="break-all sm:break-normal">jesus.pastor.ricoy@gmail.com</span>
        </a>
        <a href="https://www.linkedin.com/in/jes%C3%BAs-pastor-ricoy-4658a71a7/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 hover:text-foreground transition-colors group/link header-anim-link-2">
          <Linkedin class="w-3.5 h-3.5 text-primary shrink-0" />
          <span>LinkedIn</span>
        </a>
        <a href="https://github.com/JesusPastor96" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 hover:text-foreground transition-colors group/link header-anim-link-3">
          <Github class="w-3.5 h-3.5 text-primary shrink-0" />
          <span>GitHub</span>
        </a>
      </div>
    </div>
    
    <div class="shrink-0 self-center">
      <div class="w-36 h-36 sm:w-40 sm:h-40 md:w-48 md:h-48 rounded-full overflow-hidden transition-transform duration-500 ease-out hover:scale-[1.03] select-none photo-entrance">
        <img
          src="/img/photo.png"
          alt="Jesús Pastor Ricoy"
          class="w-full h-full object-cover select-none"
        />
      </div>
    </div>
  </div>
</header>
