---
import Layout from '../layouts/Layout.astro';
import ThemeToggle from '../components/ThemeToggle.tsx';
import ScrollToTop from '../components/ScrollToTop.tsx';
import LanguageSelector from '../components/LanguageSelector.tsx';

import Header from '../components/Header.astro';
import Experience from '../components/Experience.astro';
import ProjectsList from '../components/ProjectsList.astro';
import About from '../components/About.astro';
import Interests from '../components/Interests.tsx';
import ContactForm from '../components/ContactForm.tsx';
---

<Layout title="Jesús Pastor Ricoy | Portfolio Web">
	<header class="sticky top-0 z-40 w-full border-b border-border/40 bg-background/80 backdrop-blur-md transition-colors duration-300">
		<div class="max-w-4xl mx-auto px-4 md:px-8 h-16 flex items-center justify-between">
			<a href="#" id="nav-logo" class="logo-interactive is-assembling font-display font-bold text-xl tracking-tighter hover:scale-105 transition-transform select-none flex items-center cursor-pointer">
				<span class="logo-bracket-open text-primary">&lt;</span>
				<span class="logo-letter-j">J</span>
				<span class="logo-letter-p">P</span>
				<span class="logo-letter-r">R</span>
				<span class="logo-slash text-primary">/</span>
				<span class="logo-bracket-close text-primary">&gt;</span>
			</a>
			
			<div class="flex items-center gap-5">
				<nav class="hidden sm:flex items-center gap-6 text-sm font-medium text-muted-foreground">
					<a href="#experience" class="hover:text-foreground transition-colors nav-anim-1" data-i18n="nav.experience">Experiencia</a>
					<a href="#projects" class="hover:text-foreground transition-colors nav-anim-2" data-i18n="nav.projects">Proyectos</a>
					<a href="#about" class="hover:text-foreground transition-colors nav-anim-3" data-i18n="nav.about">Sobre mí</a>
					<a href="#contact" class="hover:text-foreground transition-colors nav-anim-4" data-i18n="nav.contact">Contacto</a>
				</nav>
				<div class="flex items-center gap-3 sm:gap-4">
					<div class="nav-anim-5">
						<ThemeToggle client:only="react" />
					</div>
					<div class="w-px h-4 bg-border/60"></div>
					<div class="nav-anim-6">
						<LanguageSelector client:only="react" />
					</div>
					<button
						id="mobile-menu-btn"
						type="button"
						class="sm:hidden p-1.5 -mr-1.5 text-muted-foreground hover:text-foreground transition-colors cursor-pointer rounded-lg hover:bg-muted/30 focus:outline-none focus-visible:outline-none focus:ring-0 active:outline-none border-none select-none"
						aria-label="Abrir menú de navegación"
						aria-expanded="false"
					>
						<svg id="menu-icon-bars" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
						</svg>
						<svg id="menu-icon-x" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
						</svg>
					</button>
				</div>
			</div>
		</div>

		<div
			id="mobile-nav-panel"
			class="hidden sm:hidden absolute top-full left-0 right-0 w-full border-b border-border/40 bg-background/85 dark:bg-background/80 backdrop-blur-xl shadow-2xl transition-all duration-300"
		>
			<nav class="max-w-4xl mx-auto px-6 py-6 flex flex-col space-y-4 text-base sm:text-lg font-medium tracking-tight">
				<a href="#experience" class="mobile-nav-link text-muted-foreground hover:text-foreground transition-colors" data-i18n="nav.experience">
					Experiencia
				</a>
				<a href="#projects" class="mobile-nav-link text-muted-foreground hover:text-foreground transition-colors" data-i18n="nav.projects">
					Proyectos
				</a>
				<a href="#about" class="mobile-nav-link text-muted-foreground hover:text-foreground transition-colors" data-i18n="nav.about">
					Sobre mí
				</a>
				<a href="#contact" class="mobile-nav-link text-muted-foreground hover:text-foreground transition-colors" data-i18n="nav.contact">
					Contacto
				</a>
			</nav>
		</div>
	</header>

	<main class="w-full flex-grow flex flex-col max-w-4xl mx-auto px-4 md:px-8 pb-16">
		<Header />
		
		<div id="experience" class="scroll-mt-20">
			<Experience />
		</div>
		
		<div id="projects" class="scroll-mt-20">
			<ProjectsList />
		</div>

		<div id="about" class="scroll-mt-20">
			<About />
		</div>

		<div id="interests" class="scroll-mt-20 reveal">
			<Interests client:visible />
		</div>

		<div id="contact" class="scroll-mt-20 reveal">
			<ContactForm client:visible />
		</div>
	</main>

	<footer class="border-t border-border/40 py-8 bg-card/10 transition-colors duration-300">
		<div class="max-w-4xl mx-auto px-4 md:px-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-muted-foreground">
			<p>
				&copy; {new Date().getFullYear()} <span class="font-semibold text-foreground">Jesús Pastor Ricoy</span>. <span data-i18n="footer.rights">Todos los derechos reservados.</span>
			</p>
			<div class="flex items-center gap-6">
				<a 
					href="https://github.com/JesusPastor96/JPRLandingPage" 
					target="_blank" 
					rel="noopener noreferrer" 
					class="flex items-center gap-1.5 hover:text-foreground transition-colors"
				>
					<svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
						<path d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.464-1.11-1.464-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.579.688.481C19.137 20.162 22 16.418 22 12c0-5.523-4.477-10-10-10z"/>
					</svg>
					<span data-i18n="footer.source">Código fuente</span>
				</a>
			</div>
		</div>
	</footer>
	<ScrollToTop client:load />

	<script is:inline>
		function setupLogoInteraction() {
			const logo = document.getElementById('nav-logo');
			if (!logo) return;
			let timeoutId = null;

			const replayLogo = () => {
				logo.classList.remove('is-assembling');
				void logo.offsetWidth;
				logo.classList.add('is-assembling');
				if (timeoutId) clearTimeout(timeoutId);
				timeoutId = setTimeout(() => {
					logo.classList.remove('is-assembling');
				}, 650);
			};

			logo.addEventListener('mouseenter', replayLogo);
			logo.addEventListener('click', (e) => {
				e.preventDefault();
				window.scrollTo({ top: 0, behavior: 'smooth' });
				replayLogo();
			});
		}

		function setupMobileNav() {
			const btn = document.getElementById('mobile-menu-btn');
			const panel = document.getElementById('mobile-nav-panel');
			const iconBars = document.getElementById('menu-icon-bars');
			const iconX = document.getElementById('menu-icon-x');
			if (!btn || !panel) return;

			btn.addEventListener('click', () => {
				const isHidden = panel.classList.toggle('hidden');
				iconBars?.classList.toggle('hidden', !isHidden);
				iconX?.classList.toggle('hidden', isHidden);
				btn.setAttribute('aria-expanded', isHidden ? 'false' : 'true');
			});

			panel.querySelectorAll('.mobile-nav-link').forEach((link) => {
				link.addEventListener('click', () => {
					panel.classList.add('hidden');
					iconBars?.classList.remove('hidden');
					iconX?.classList.add('hidden');
					btn.setAttribute('aria-expanded', 'false');
				});
			});

			document.addEventListener('click', (e) => {
				if (!panel.contains(e.target) && !btn.contains(e.target) && !panel.classList.contains('hidden')) {
					panel.classList.add('hidden');
					iconBars?.classList.remove('hidden');
					iconX?.classList.add('hidden');
					btn.setAttribute('aria-expanded', 'false');
				}
			});
		}

		function initPage() {
			setupLogoInteraction();
			setupMobileNav();
		}

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', initPage);
		} else {
			initPage();
		}
	</script>
</Layout>
